# Sovereign AI Workbench - Environment Configuration

# Hardware tier: BUILD, DEMO, or PROD
HARDWARE_TIER=BUILD

# Database credentials (update for production)
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=sovereign_ai
POSTGRES_USER=sovereign

# Qdrant configuration
QDRANT_PORT=6333

# Sentinel configuration
SENTINEL_ALLOW_LIST=127.0.0.1,0.0.0.0,::1

# Logging level
LOG_LEVEL=INFO
